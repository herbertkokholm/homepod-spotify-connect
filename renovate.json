{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>herbertkokholm/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "go-librespot release downloaded by deploy.sh",
      "managerFilePatterns": ["/^deploy\\.sh$/"],
      "matchStrings": ["GO_LIBRESPOT_VERSION=\"\\$\\{GO_LIBRESPOT_VERSION:-(?<currentValue>v[^}]+)\\}\""],
      "depNameTemplate": "devgianlu/go-librespot",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "go-librespot updates immediately, in its own PR",
      "matchDepNames": ["devgianlu/go-librespot"],
      "groupName": "go-librespot",
      "schedule": ["at any time"]
    }
  ]
}
