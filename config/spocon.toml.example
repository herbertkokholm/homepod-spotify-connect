# SpoCon Configuration
# /opt/spocon/config.toml
#
# Full documentation: https://github.com/spocon/spocon
# librespot-java options: https://github.com/librespot-org/librespot-java

# Device name shown in Spotify Connect
deviceName = "HomePod"

# Device type (affects icon in Spotify)
# Options: COMPUTER, TABLET, SMARTPHONE, SPEAKER, TV, AVR, STB, AUDIO_DONGLE,
#          GAME_CONSOLE, CAST_VIDEO, CAST_AUDIO, AUTOMOBILE, WEARABLE, CAR_THING
deviceType = "SPEAKER"

# Preferred language
preferredLocale = "en"

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
[auth]
# ZEROCONF: Anyone on network can use (default)
# USER_PASS: Restrict to specific account
# BLOB: Use saved authentication blob
strategy = "ZEROCONF"

# For USER_PASS strategy - restricts to your account only
username = ""
password = ""

# For BLOB strategy
blob = ""

# ------------------------------------------------------------------------------
# Zeroconf (Network Discovery)
# ------------------------------------------------------------------------------
[zeroconf]
# Port for Spotify to connect (-1 = random)
listenPort = -1

# Listen on all network interfaces
listenAll = true

# Or specify interfaces (comma separated)
interfaces = ""

# ------------------------------------------------------------------------------
# Cache
# ------------------------------------------------------------------------------
[cache]
enabled = true
dir = "/tmp/spocon_cache/"
doCleanUp = true

# ------------------------------------------------------------------------------
# Preload
# ------------------------------------------------------------------------------
[preload]
# Preload next track for gapless playback
enabled = true

# ------------------------------------------------------------------------------
# Time Synchronization
# ------------------------------------------------------------------------------
[time]
# NTP, PING, MELODY, or MANUAL
synchronizationMethod = "NTP"
manualCorrection = 0

# ------------------------------------------------------------------------------
# Player Settings
# ------------------------------------------------------------------------------
[player]
# Auto-play similar songs when queue ends
autoplayEnabled = true

# Audio quality (requires Premium)
# Options: VORBIS_96, VORBIS_160, VORBIS_320
preferredAudioQuality = "VORBIS_320"

# Loudness normalization
enableNormalisation = true
normalisationPregain = 3.0

# Initial volume (0-65536)
# 21845 = ~33%, 43690 = ~66%, 65536 = 100%
initialVolume = 21845

# Volume steps for remote control
volumeSteps = 64

# Log available audio mixers on startup
logAvailableMixers = true

# Search keywords for mixer selection
mixerSearchKeywords = ""

# Crossfade duration in milliseconds (0 = disabled)
crossfadeDuration = 0

# Output mode: MIXER (local audio), PIPE, STDOUT
output = "PIPE"

# Release audio device after this many seconds of silence
releaseLineDelay = 20

# Named pipe path (for PIPE output)
pipe = "/srv/music/spotify"

# Metadata pipe path
metadataPipe = "/srv/music/spotify.metadata"
